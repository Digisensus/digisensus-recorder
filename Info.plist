    <!-- Over-the-air updates (Sparkle). The feed address comes from the app (it follows the
         Digisensus server and the beta setting). build.sh deletes SUPublicEDKey so local builds
         never update themselves; package.sh refuses to package without it. -->
    <key>SUPublicEDKey</key>
    <string>ao+z4rVHRqn02vrSOv3prdq6BAN/fXRo3zoMTRX3k90=</string>
    <key>SUEnableAutomaticChecks</key>
    <true/>
    <key>SUAutomaticallyUpdate</key>
    <true/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <!-- The App Store build's "Update in App Store" opens this app's page (UpdateController). -->
    <key>DSAppStoreID</key>
    <string>6817626979</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <!-- Only standard HTTPS: exempt from export compliance (asked for App Store uploads). -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- A regular app with a Dock icon (Settings › General › "Show in the Dock" can hide it;
         the app then lives in the menu bar only while no window is open). -->
    <key>LSUIElement</key>
    <false/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <!-- The transcription server is user-configured and is typically plain http on the LAN. -->
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Digisensus Recorder sends recordings and transcripts to the AI servers you choose on your network.</string>
    <key>NSMicrophoneUsageDescription</key>
