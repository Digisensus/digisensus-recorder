    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف Digisensus Recorder مهام المكالمة إلى التذكيرات، فقط عندما تختار ذلك. ولا يقرأ تذكيراتك أبدًا."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder přidává úkoly z hovoru do Připomínek, pouze když to zvolíte. Vaše připomínky nikdy nečte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder føjer et opkalds opgaver til Påmindelser, men kun når du vælger det. Appen læser aldrig dine påmindelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder fügt die Aufgaben eines Anrufs zu Erinnerungen hinzu, aber nur, wenn Sie es möchten. Ihre Erinnerungen werden nie gelesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder adds a call's action items to Reminders, only when you choose to. It never reads your reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder añade las tareas de una llamada a Recordatorios, solo cuando tú quieras. Nunca lee tus recordatorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder ajoute les actions à mener d’un appel à Rappels, uniquement si vous le souhaitez. Il ne lit jamais vos rappels."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder מוסיפה את המשימות מהשיחה לתזכורות, רק כשתבחר בכך. היא אף פעם לא קוראת את התזכורות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder कॉल के ऐक्शन आइटम रिमाइंडर में जोड़ता है, केवल तभी जब आप चाहें। यह आपके रिमाइंडर कभी नहीं पढ़ता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder menambahkan item tindakan dari panggilan ke Pengingat, hanya saat Anda memilihnya. App ini tidak pernah membaca pengingat Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder aggiunge a Promemoria le attività da svolgere di una chiamata, solo quando lo scegli tu. Non legge mai i tuoi promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorderは、選択したときだけ通話のアクションアイテムをリマインダーに追加します。リマインダーを読み取ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder는 사용자가 원할 때만 통화의 할 일을 미리 알림에 추가합니다. 미리 알림을 읽지 않습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder prideda skambučio užduotis į Priminimus tik tada, kai to norite. Jūsų priminimų jis niekada neskaito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder zet de actiepunten van een gesprek in Herinneringen, alleen als je daarvoor kiest. Het leest je herinneringen nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder dodaje zadania z rozmowy do Przypomnień tylko wtedy, gdy tego zechcesz. Nigdy nie odczytuje Twoich przypomnień."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Digisensus Recorder adiciona as tarefas de uma chamada aos Lembretes, só quando você escolhe. Ele nunca lê os seus lembretes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder добавляет задачи из звонка в Напоминания, только когда Вы этого захотите. Приложение никогда не читает Ваши напоминания."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder lägger till ett samtals åtgärdspunkter i Påminnelser, bara när du väljer det. Appen läser aldrig dina påminnelser."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder จะเพิ่มสิ่งที่ต้องทำจากการโทรลงในเตือนความจำเฉพาะเมื่อคุณเลือกเท่านั้น และจะไม่อ่านรายการเตือนความจำของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder, yalnızca siz istediğinizde bir görüşmenin yapılacaklarını Anımsatıcılar'a ekler. Anımsatıcılarınızı asla okumaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder додає завдання з дзвінка в Нагадування, лише коли ви цього захочете. Програма ніколи не читає ваші нагадування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder chỉ thêm việc cần làm của cuộc gọi vào Lời nhắc khi bạn chọn. Ứng dụng không bao giờ đọc lời nhắc của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当你选择时，Digisensus Recorder 才会将通话的待办事项添加到“提醒事项”。它绝不会读取你的提醒事项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在你選擇時，Digisensus Recorder 才會將通話的待辦事項加入「提醒事項」。它絕不會讀取你的提醒事項。"
          }
        }
      }
    }
  },
