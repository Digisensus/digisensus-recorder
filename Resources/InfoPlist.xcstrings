          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder ส่งไฟล์บันทึกและข้อความถอดเสียงไปยังเซิร์ฟเวอร์ AI ที่คุณเลือกบนเครือข่ายของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder, kayıtları ve transkriptleri ağınızda seçtiğiniz YZ sunucularına gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder надсилає записи й транскрипти на вибрані вами ШІ-сервери у вашій мережі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder gửi bản ghi và bản chép lời tới các máy chủ AI mà bạn chọn trên mạng của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder 会将录音和转录文本发送到你在网络上选择的 AI 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Digisensus Recorder 會將錄音和轉錄文字傳送到你在網路上選擇的 AI 伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
