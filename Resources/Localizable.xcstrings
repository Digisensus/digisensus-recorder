    "This is a local build, which doesn't update itself. Release builds check for updates at launch and every 24 hours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا إصدار محلي لا يحدّث نفسه. تتحقق إصدارات النشر من التحديثات عند التشغيل وكل 24 ساعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto je lokální sestavení, které se samo neaktualizuje. Vydaná sestavení hledají aktualizace při spuštění a každých 24 hodin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er en lokal build, som ikke opdaterer sig selv. Udgivne versioner søger efter opdateringer ved start og hver 24. time."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist ein lokaler Build, der sich nicht selbst aktualisiert. Release-Builds suchen beim Start und alle 24 Stunden nach Updates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es una compilación local, que no se actualiza sola. Las versiones publicadas buscan actualizaciones al abrirse y cada 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est une version locale, qui ne se met pas à jour seule. Les versions publiées recherchent des mises à jour au lancement et toutes les 24 heures."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זו גרסה מקומית שלא מתעדכנת מעצמה. גרסאות רשמיות בודקות אם יש עדכונים בהפעלה וכל 24 שעות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह एक लोकल बिल्ड है, जो अपने आप अपडेट नहीं होता। रिलीज़ बिल्ड लॉन्च पर और हर 24 घंटे में अपडेट जाँचते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini adalah build lokal yang tidak memperbarui dirinya sendiri. Build rilis memeriksa pembaruan saat dijalankan dan setiap 24 jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è una build locale, che non si aggiorna da sola. Le build ufficiali cercano aggiornamenti all'avvio e ogni 24 ore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはローカルビルドのため、自動ではアップデートされません。リリースビルドは起動時と24時間ごとにアップデートを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 빌드이므로 자동으로 업데이트되지 않습니다. 릴리스 빌드는 실행할 때와 24시간마다 업데이트를 확인합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai vietinė versija, kuri savaime neatsinaujina. Oficialios versijos naujinių ieško paleidžiamos ir kas 24 valandas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit is een lokale build, die zichzelf niet bijwerkt. Releasebuilds zoeken bij het opstarten en elke 24 uur naar updates."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To lokalna kompilacja, która nie uaktualnia się sama. Wersje wydane sprawdzają uaktualnienia przy uruchomieniu i co 24 godziny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta é uma versão local, que não se atualiza sozinha. As versões oficiais buscam atualizações ao abrir e a cada 24 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это локальная сборка, она не обновляется сама. Релизные сборки проверяют обновления при запуске и каждые 24 часа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det här är en lokal version som inte uppdaterar sig själv. Officiella versioner söker efter uppdateringar vid start och var 24:e timme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่คือบิลด์ภายในเครื่องซึ่งไม่อัปเดตตัวเอง บิลด์รุ่นเผยแพร่จะตรวจหาอัปเดตเมื่อเปิดแอปและทุก 24 ชั่วโมง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, kendini güncellemeyen yerel bir derlemedir. Sürüm derlemeleri açılışta ve her 24 saatte bir güncellemeleri denetler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це локальна збірка, вона не оновлюється сама. Релізні збірки перевіряють оновлення під час запуску й кожні 24 години."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là bản dựng cục bộ, không tự cập nhật. Bản phát hành kiểm tra cập nhật khi khởi chạy và mỗi 24 giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是本地构建版本，不会自动更新。正式版本会在启动时以及每 24 小时检查一次更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是本機建置版本，不會自動更新。正式版本會在啟動時以及每 24 小時檢查一次更新項目。"
          }
        }
      }
    },
