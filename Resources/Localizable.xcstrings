    "Start and stop recordings (agents can never delete)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدء التسجيلات وإيقافها (لا يمكن للوكلاء الحذف أبدًا)"
          }
        },
        "cs" : {
          "stringUnit" : {
