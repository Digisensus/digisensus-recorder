    "Signed in. The invite code only applies to new Digisensus users, so no referral credit this time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل الدخول. رمز الدعوة يسري على مستخدمي Digisensus الجدد فقط، لذا لا يوجد رصيد إحالة هذه المرة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlášeno. Kód pozvánky platí jen pro nové uživatele Digisensus, takže tentokrát kredit za doporučení nezískáte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logget ind. Invitationskoden gælder kun for nye Digisensus-brugere, så der er ingen henvisningskredit denne gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angemeldet. Der Einladungscode gilt nur für neue Digisensus-Nutzer, daher gibt es diesmal kein Empfehlungsguthaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión iniciada. El código de invitación solo vale para nuevos usuarios de Digisensus, así que esta vez no hay crédito por invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecté. Le code d’invitation ne s’applique qu’aux nouveaux utilisateurs de Digisensus ; pas de crédit de parrainage cette fois."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מחובר. קוד ההזמנה חל רק על משתמשי Digisensus חדשים, ולכן הפעם אין קרדיט הפניה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साइन इन हो गया। आमंत्रण कोड केवल नए Digisensus उपयोगकर्ताओं पर लागू होता है, इसलिए इस बार रेफ़रल क्रेडिट नहीं मिलेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda sudah masuk. Kode undangan hanya berlaku untuk pengguna baru Digisensus, jadi kali ini tidak ada kredit referal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesso effettuato. Il codice invito vale solo per i nuovi utenti Digisensus, quindi questa volta niente credito da inviti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしました。招待コードはDigisensusの新規ユーザのみが対象のため、今回は紹介クレジットはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인되었습니다. 초대 코드는 Digisensus 신규 사용자에게만 적용되므로 이번에는 추천 크레딧이 지급되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijungta. Pakvietimo kodas taikomas tik naujiems Digisensus naudotojams, todėl kredito už pakvietimą šį kartą nebus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingelogd. De uitnodigingscode geldt alleen voor nieuwe Digisensus-gebruikers, dus deze keer geen verwijzingstegoed."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zalogowano. Kod zaproszenia dotyczy tylko nowych użytkowników Digisensus, więc tym razem bez bonusu za polecenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessão iniciada. O código de convite só vale para novos usuários da Digisensus, então desta vez não há crédito de indicação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход выполнен. Код приглашения действует только для новых пользователей Digisensus, поэтому реферального бонуса в этот раз не будет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inloggad. Inbjudningskoden gäller bara nya Digisensus-användare, så ingen inbjudningskredit den här gången."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลงชื่อเข้าแล้ว รหัสเชิญใช้ได้เฉพาะผู้ใช้ Digisensus ใหม่เท่านั้น ครั้งนี้จึงไม่ได้รับเครดิตแนะนำเพื่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş yapıldı. Davet kodu yalnızca yeni Digisensus kullanıcıları için geçerli olduğundan bu kez davet kredisi verilmedi."
          }
        },
        "uk" : {
          "stringUnit" : {
