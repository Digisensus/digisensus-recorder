    "This removes your email address and signs out every device. Recordings on this Mac are not affected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة بريدك الإلكتروني وتسجيل الخروج من كل الأجهزة. لا تتأثر التسجيلات الموجودة على هذا الـ Mac."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
