    "Other server takes any OpenAI-compatible API. Models and language can be changed later in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«خادم آخر» يقبل أي API متوافقة مع OpenAI. يمكن تغيير النماذج واللغة لاحقًا في الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jiný server přijme jakékoli API kompatibilní s OpenAI. Modely a jazyk můžete později změnit v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anden server tager enhver OpenAI-kompatibel API. Modeller og sprog kan ændres senere i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Anderer Server“ unterstützt jede OpenAI-kompatible API. Modelle und Sprache lassen sich später in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Otro servidor” admite cualquier API compatible con OpenAI. Puedes cambiar los modelos y el idioma más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Autre serveur » accepte toute API compatible OpenAI. Les modèles et la langue peuvent être modifiés plus tard dans Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"שרת אחר\" מקבל כל API תואם OpenAI. ניתן לשנות מודלים ושפה מאוחר יותר בהגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“अन्य सर्वर” कोई भी OpenAI-संगत API स्वीकार करता है। मॉडल और भाषा बाद में सेटिंग्ज़ में बदले जा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server lain menerima API apa pun yang kompatibel dengan OpenAI. Model dan bahasa dapat diubah nanti di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altro server accetta qualsiasi API compatibile con OpenAI. Modelli e lingua si possono cambiare in seguito in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「その他のサーバ」ではOpenAI互換のAPIを使用できます。モデルと言語は後から「設定」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기타 서버는 모든 OpenAI 호환 API를 지원합니다. 모델과 언어는 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitas serveris tinka bet kuriai su OpenAI suderinamai API. Modelius ir kalbą vėliau galėsite pakeisti nustatymuose."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere server werkt met elke OpenAI-compatibele API. Modellen en taal kun je later wijzigen in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inny serwer obsługuje dowolne API zgodne z OpenAI. Modele i język możesz później zmienić w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro servidor aceita qualquer API compatível com OpenAI. Modelos e idioma podem ser alterados depois em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Другой сервер» поддерживает любой API, совместимый с OpenAI. Модели и язык можно изменить позже в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annan server fungerar med alla OpenAI-kompatibla API:er. Modeller och språk kan ändras senare i Inställningar."
