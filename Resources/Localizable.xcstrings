    "It's built on these open source projects. Thank you to everyone who maintains them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهو مبني على هذه المشاريع مفتوحة المصدر. شكرًا لكل من يقوم على صيانتها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace stojí na těchto open source projektech. Děkujeme všem, kdo je udržují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den er bygget på disse open source-projekter. Tak til alle, der vedligeholder dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App basiert auf diesen Open-Source-Projekten. Danke an alle, die sie pflegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se basa en estos proyectos de código abierto. Gracias a todas las personas que los mantienen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app repose sur ces projets open source. Merci à toutes les personnes qui les maintiennent."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היא בנויה על פרויקטי הקוד הפתוח האלה. תודה לכל מי שמתחזק אותם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इन ओपन सोर्स प्रोजेक्ट पर बना है। इन्हें मेंटेन करने वाले सभी लोगों का धन्यवाद।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App ini dibangun di atas proyek sumber terbuka berikut. Terima kasih kepada semua pengelolanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È basata su questi progetti open source. Grazie a tutti coloro che li mantengono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このAppは以下のオープンソースプロジェクトを使用しています。メンテナンスに携わるすべての方に感謝します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 다음 오픈 소스 프로젝트를 기반으로 합니다. 프로젝트를 관리하는 모든 분께 감사드립니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
