    "Today's credit is used up. Transcripts and summaries resume when it renews." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نفد رصيد اليوم. يُستأنف التفريغ والتلخيص عند تجديده."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní kredit je vyčerpán. Přepisy a shrnutí budou pokračovat po jeho obnovení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens kredit er brugt. Udskrifter og resuméer genoptages, når den fornyes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heutige Guthaben ist aufgebraucht. Transkripte und Zusammenfassungen gehen weiter, sobald es erneuert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El crédito de hoy se ha agotado. Las transcripciones y los resúmenes se reanudarán cuando se renueve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le crédit du jour est épuisé. Les transcriptions et résumés reprendront à son renouvellement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הקרדיט של היום נוצל. תמלילים וסיכומים יחזרו כשהוא יתחדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज का क्रेडिट खत्म हो गया। क्रेडिट रिन्यू होने पर ट्रांसक्रिप्ट और सारांश फिर शुरू होंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kredit hari ini sudah habis. Transkrip dan ringkasan akan berlanjut saat kredit diperbarui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il credito di oggi è esaurito. Trascrizioni e riepiloghi riprenderanno al rinnovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日のクレジットを使い切りました。クレジットが更新されると、文字起こしと要約を再開できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 크레딧을 모두 사용했습니다. 크레딧이 갱신되면 녹취록과 요약이 다시 시작됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiandienos kreditas išnaudotas. Stenogramos ir santraukos bus vėl kuriamos, kai jis atsinaujins."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het tegoed van vandaag is op. Transcripten en samenvattingen gaan verder zodra het is aangevuld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dzisiejszy limit się wyczerpał. Transkrypcje i podsumowania wrócą, gdy się odnowi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O crédito de hoje acabou. Transcrições e resumos voltam quando ele for renovado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лимит на сегодня исчерпан. Расшифровки и сводки возобновятся, когда он обновится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens kredit är slut. Transkriptioner och sammanfattningar fortsätter när den förnyas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เครดิตของวันนี้หมดแล้ว ข้อความถอดเสียงและสรุปจะกลับมาทำงานเมื่อเครดิตต่ออายุ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü kredi tükendi. Transkriptler ve özetler kredi yenilenince devam eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ліміт на сьогодні вичерпано. Транскрипти й підсумки відновляться, коли він оновиться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã dùng hết tín dụng hôm nay. Bản chép lời và tóm tắt sẽ tiếp tục khi tín dụng được làm mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日额度已用完。额度更新后即可继续转录和生成摘要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日額度已用完。額度更新後即可繼續轉錄和產生摘要。"
          }
        }
      }
    },
