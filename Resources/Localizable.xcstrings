    "Allow Digisensus Recorder in System Settings › Privacy & Security › Reminders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Digisensus Recorder في إعدادات النظام › الخصوصية والأمن › التذكيرات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte Digisensus Recorder v Nastavení systému › Soukromí a zabezpečení › Připomínky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad Digisensus Recorder i Systemindstillinger › Anonymitet & sikkerhed › Påmindelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Digisensus Recorder den Zugriff unter Systemeinstellungen › Datenschutz & Sicherheit › Erinnerungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da permiso a Digisensus Recorder en Ajustes del Sistema › Privacidad y seguridad › Recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Digisensus Recorder dans Réglages Système › Confidentialité et sécurité › Rappels."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר את Digisensus Recorder בהגדרות המערכת › פרטיות ואבטחה › תזכורות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्ज़ › गोपनीयता और सुरक्षा › रिमाइंडर में Digisensus Recorder को अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Digisensus Recorder di Pengaturan Sistem › Privasi & Keamanan › Pengingat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l'accesso a Digisensus Recorder in Impostazioni di Sistema › Privacy e sicurezza › Promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」›「プライバシーとセキュリティ」›「リマインダー」でDigisensus Recorderを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 미리 알림에서 Digisensus Recorder를 허용하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suteikite leidimą Digisensus Recorder skiltyje Sistemos nustatymai › Privatumas ir saugumas › Priminimai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Digisensus Recorder toe in Systeeminstellingen › Privacy en beveiliging › Herinneringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól aplikacji Digisensus Recorder w Ustawieniach systemowych › Prywatność i ochrona › Przypomnienia."
