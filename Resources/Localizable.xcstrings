    "Jot down anything while you talk. Notes are saved with the recording." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوّن أي شيء أثناء حديثك. تُحفظ الملاحظات مع التسجيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisujte si během hovoru cokoli. Poznámky se uloží s nahrávkou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv hvad som helst ned, mens du taler. Noter gemmes sammen med optagelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notieren Sie während des Gesprächs, was Sie möchten. Notizen werden mit der Aufnahme gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta lo que quieras mientras hablas. Las notas se guardan con la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez ce que vous voulez pendant l’appel. Les notes sont conservées avec l’enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רשום כל דבר תוך כדי שיחה. ההערות נשמרות עם ההקלטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बात करते समय कुछ भी लिख लें। नोट्स रिकॉर्डिंग के साथ सहेजे जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat apa saja sambil berbicara. Catatan disimpan bersama rekaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annota qualsiasi cosa mentre parli. Le note vengono salvate con la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話しながら何でもメモできます。メモは録音と一緒に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화하면서 무엇이든 적어 두세요. 메모는 녹음과 함께 저장됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Užsirašykite ką nors pokalbio metu. Pastabos išsaugomos kartu su įrašu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noteer van alles terwijl je praat. Notities worden bij de opname bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj, co chcesz, w trakcie rozmowy. Notatki są zachowywane razem z nagraniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote o que quiser enquanto fala. As notas são salvas com a gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте все, что нужно, прямо во время разговора. Заметки сохраняются вместе с записью."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteckna vad du vill medan du pratar. Anteckningarna sparas med inspelningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดอะไรก็ได้ระหว่างคุยสาย โน้ตจะบันทึกไว้พร้อมกับไฟล์บันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşurken aklınıza geleni not alın. Notlar kayıtla birlikte saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Занотовуйте що завгодно під час розмови. Нотатки зберігаються разом із записом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi lại bất cứ điều gì khi bạn nói chuyện. Ghi chú được lưu cùng bản ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通话时可随手记下任何内容。笔记会随录音一起存储。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話時可隨手記下任何內容。筆記會隨錄音一起儲存。"
          }
        }
      }
    },
