    "Zoom, Meet, Teams, FaceTime and phone calls. Telling others is up to you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكالمات Zoom وMeet وTeams وFaceTime والهاتف. إبلاغ الآخرين مسؤوليتك أنت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hovory přes Zoom, Meet, Teams, FaceTime a telefon. Informovat ostatní je na vás."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom-, Meet-, Teams-, FaceTime- og telefonopkald. Det er op til dig at fortælle det til andre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Meet, Teams, FaceTime und Telefonanrufe. Andere zu informieren, liegt bei Ihnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Meet, Teams, FaceTime y llamadas telefónicas. Avisar a los demás es responsabilidad tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Meet, Teams, FaceTime et appels téléphoniques. C’est à vous de prévenir les autres."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיחות Zoom, Meet, Teams, FaceTime וטלפון. האחריות ליידע אחרים היא שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Meet, Teams, FaceTime और फ़ोन कॉल। दूसरों को बताना आपकी ज़िम्मेदारी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panggilan Zoom, Meet, Teams, FaceTime, dan telepon. Memberi tahu orang lain adalah tanggung jawab Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiamate Zoom, Meet, Teams, FaceTime e telefoniche. Avvisare gli altri spetta a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom、Meet、Teams、FaceTime、電話の通話。相手への告知はユーザの責任です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Meet, Teams, FaceTime 및 전화 통화. 상대방에게 알리는 것은 사용자의 책임입니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Meet, Teams, FaceTime ir telefono skambučiai. Pranešti kitiems – jūsų atsakomybė."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom-, Meet-, Teams-, FaceTime- en telefoongesprekken. Anderen inlichten is aan jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Meet, Teams, FaceTime i rozmowy telefoniczne. O informowaniu innych decydujesz Ty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chamadas de Zoom, Meet, Teams, FaceTime e telefone. Avisar os outros é com você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom, Meet, Teams, FaceTime и телефонные звонки. Предупреждать собеседников — Ваша ответственность."
          }
        },
        "sv" : {
          "stringUnit" : {
