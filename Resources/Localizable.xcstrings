    "Sign in to Digisensus in Settings › Transcription & AI, or choose Local & Cloud API." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول إلى Digisensus في الإعدادات › التفريغ والذكاء الاصطناعي، أو اختر «API محلية وسحابية»."
          }
        },
        "cs" : {
