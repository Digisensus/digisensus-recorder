          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này xóa địa chỉ email của bạn và đăng xuất mọi thiết bị. Các bản ghi trên máy Mac này không bị ảnh hưởng."
