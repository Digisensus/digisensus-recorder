    "Evens out both voices and removes echo when you're not using headphones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوازن بين الصوتين ويزيل الصدى عندما لا تستخدم سماعات الرأس."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyrovná hlasitost obou hlasů a odstraní ozvěnu, když nepoužíváte sluchátka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udligner begge stemmer og fjerner ekko, når du ikke bruger hovedtelefoner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleicht beide Stimmen an und entfernt Echo, wenn Sie keine Kopfhörer verwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibra ambas voces y elimina el eco cuando no usas auriculares."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Équilibre les deux voix et supprime l’écho si vous n’utilisez pas d’écouteurs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאזן את שני הקולות ומסיר הד כשאינך משתמש באוזניות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हेडफ़ोन न लगाने पर दोनों आवाज़ों को संतुलित करता है और गूँज हटाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyeimbangkan kedua suara dan menghilangkan gema saat Anda tidak memakai headphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilancia le due voci e rimuove l'eco quando non usi le cuffie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "双方の音量をそろえ、ヘッドフォン未使用時のエコーを除去します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 목소리의 음량을 고르게 맞추고, 헤드폰을 사용하지 않을 때 에코를 제거합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suvienodina abiejų balsų garsumą ir pašalina aidą, kai nenaudojate ausinių."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt beide stemmen even luid en verwijdert echo als je geen koptelefoon gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrównuje oba głosy i usuwa echo, gdy nie używasz słuchawek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Equilibra as duas vozes e remove o eco quando você não usa fones de ouvido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выравнивает громкость голосов и убирает эхо, если Вы без наушников."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämnar ut båda rösterna och tar bort eko när du inte använder hörlurar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับระดับเสียงทั้งสองฝั่งให้เท่ากันและตัดเสียงสะท้อนเมื่อคุณไม่ได้ใช้หูฟัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kulaklık kullanmadığınızda iki sesi dengeler ve yankıyı giderir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вирівнює гучність голосів і прибирає луну, якщо ви без навушників."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cân bằng hai giọng nói và khử tiếng vọng khi bạn không dùng tai nghe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
