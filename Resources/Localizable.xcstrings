    "Reminders has no default list. Choose one in Reminders › Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد في التذكيرات قائمة افتراضية. اختر واحدة في التذكيرات › الإعدادات."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomínky nemají výchozí seznam. Vyberte ho v nabídce Připomínky › Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påmindelser har ingen standardliste. Vælg en i Påmindelser › Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen hat keine Standardliste. Wählen Sie eine unter Erinnerungen › Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorios no tiene una lista predeterminada. Elige una en Recordatorios › Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappels n’a pas de liste par défaut. Choisissez-en une dans Rappels › Réglages."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לתזכורות אין רשימת ברירת מחדל. בחר אחת בתזכורות › הגדרות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिमाइंडर में कोई डिफ़ॉल्ट सूची नहीं है। रिमाइंडर › सेटिंग्ज़ में एक चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengingat tidak memiliki daftar default. Pilih satu di Pengingat › Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria non ha un elenco predefinito. Scegline uno in Promemoria › Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーにデフォルトのリストがありません。「リマインダー」›「設定」で選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 알림에 기본 목록이 없습니다. 미리 알림 › 설정에서 선택하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priminimuose nenustatytas numatytasis sąrašas. Pasirinkite jį skiltyje Priminimai › Nustatymai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinneringen heeft geen standaardlijst. Kies er een in Herinneringen › Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnienia nie mają domyślnej listy. Wybierz ją w Przypomnienia › Ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app Lembretes não tem uma lista padrão. Escolha uma em Lembretes › Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Напоминаниях не выбран список по умолчанию. Выберите его в меню «Напоминания» › «Настройки»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påminnelser har ingen standardlista. Välj en i Påminnelser › Inställningar."
          }
        },
        "th" : {
