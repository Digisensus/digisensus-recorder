          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione rimuove il tuo indirizzo email e disconnette tutti i dispositivi. Le registrazioni su questo Mac non vengono toccate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアドレスが削除され、すべてのデバイスからサインアウトされます。このMac上の録音には影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이메일 주소가 삭제되고 모든 기기에서 로그아웃됩니다. 이 Mac의 녹음에는 영향을 주지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
