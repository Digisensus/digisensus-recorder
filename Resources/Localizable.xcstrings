    "Update in the App Store to keep using Digisensus transcripts and summaries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّث التطبيق من App Store لمواصلة استخدام التفريغ والملخصات من Digisensus."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualizujte v App Storu, abyste mohli dál používat přepisy a shrnutí Digisensus."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opdater i App Store for at blive ved med at bruge Digisensus' udskrifter og resuméer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktualisieren Sie im App Store, um weiterhin Transkripte und Zusammenfassungen von Digisensus zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actualiza en el App Store para seguir usando las transcripciones y resúmenes de Digisensus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez à jour depuis l’App Store pour continuer à utiliser les transcriptions et résumés Digisensus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עדכן ב-App Store כדי להמשיך להשתמש בתמלילים ובסיכומים של Digisensus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus ट्रांसक्रिप्ट और सारांश इस्तेमाल करते रहने के लिए App Store में अपडेट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perbarui di App Store untuk terus menggunakan transkrip dan ringkasan Digisensus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiorna da App Store per continuare a usare trascrizioni e riepiloghi Digisensus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensusの文字起こしと要約を引き続き使用するには、App Storeでアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus 녹취록과 요약을 계속 사용하려면 App Store에서 업데이트하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atnaujinkite programą App Store, kad galėtumėte toliau naudotis Digisensus stenogramomis ir santraukomis."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werk bij via de App Store om Digisensus-transcripten en -samenvattingen te blijven gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uaktualnij w App Store, aby nadal korzystać z transkrypcji i podsumowań Digisensus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atualize na App Store para continuar usando as transcrições e os resumos da Digisensus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите приложение в App Store, чтобы и дальше пользоваться расшифровками и сводками Digisensus."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppdatera i App Store för att fortsätta använda Digisensus transkriptioner och sammanfattningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัปเดตใน App Store เพื่อใช้ข้อความถอดเสียงและสรุปของ Digisensus ต่อไป"
          }
        },
        "tr" : {
