    "Starts and stops with your calls. Telling others they're being recorded is up to you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ ويتوقف مع مكالماتك. إبلاغ الآخرين بأنهم يُسجَّلون مسؤوليتك أنت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spouští se a zastavuje s vašimi hovory. Informovat ostatní, že jsou nahráváni, je na vás."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starter og stopper med dine opkald. Det er op til dig at fortælle andre, at de bliver optaget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet und stoppt mit Ihren Anrufen. Andere über die Aufnahme zu informieren, liegt bei Ihnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza y termina con tus llamadas. Avisar a los demás de que se les graba es responsabilidad tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre et s’arrête avec vos appels. C’est à vous de prévenir les autres qu’ils sont enregistrés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מתחיל ונעצר עם השיחות שלך. האחריות ליידע אחרים שהם מוקלטים היא שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी कॉल के साथ शुरू होता है और रुकता है। दूसरों को बताना कि उन्हें रिकॉर्ड किया जा रहा है, आपकी ज़िम्मेदारी है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dan berhenti bersama panggilan Anda. Memberi tahu orang lain bahwa mereka sedang direkam adalah tanggung jawab Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parte e si ferma con le tue chiamate. Avvisare gli altri che vengono registrati spetta a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話に合わせて開始・停止します。録音していることを相手に伝えるのはユーザの責任です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화와 함께 시작하고 멈춥니다. 녹음 중임을 상대방에게 알리는 것은 사용자의 책임입니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prasideda ir baigiasi kartu su skambučiais. Pranešti kitiems, kad jie įrašomi, – jūsų atsakomybė."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start en stopt met je gesprekken. Het is aan jou om anderen te laten weten dat ze worden opgenomen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startuje i kończy się razem z rozmowami. O informowaniu innych o nagrywaniu decydujesz Ty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Começa e para com as suas chamadas. Avisar os outros de que estão sendo gravados é responsabilidade sua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинается и заканчивается вместе со звонками. Предупреждать собеседников о записи — Ваша ответственность."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startar och stoppar med dina samtal. Det är ditt ansvar att berätta för andra att de spelas in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มและหยุดพร้อมการโทร การแจ้งให้ผู้อื่นทราบว่ากำลังถูกบันทึกเป็นหน้าที่ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüşmelerinizle başlar ve durur. Karşı tarafa kaydedildiğini söylemek size kalmış."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Починається й зупиняється разом із дзвінками. Попереджати інших про запис — ваша відповідальність."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu và dừng theo cuộc gọi. Việc báo cho người khác biết họ đang được ghi âm là trách nhiệm của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随通话开始和停止。告知他人正在录音是你的责任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隨通話開始和停止。告知他人正在錄音是你的責任。"
          }
        }
      }
    },
