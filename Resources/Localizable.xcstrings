            "value" : "Spouštět a zastavovat nahrávání (agenti nikdy nemohou mazat)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte og stoppe optagelser (agenter kan aldrig slette)"
          }
