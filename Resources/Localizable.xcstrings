    "Goes to the default calendar in Calendar, including Google or Exchange accounts added in System Settings › Internet Accounts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضاف إلى التقويم الافتراضي في تطبيق التقويم، بما في ذلك حسابات Google أو Exchange المضافة في إعدادات النظام › حسابات الإنترنت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uloží se do výchozího kalendáře v Kalendáři, včetně účtů Google nebo Exchange přidaných v Nastavení systému › Internetové účty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føjes til standardkalenderen i Kalender, inklusive Google- og Exchange-konti, der er tilføjet i Systemindstillinger › Internetkonti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Landet im Standardkalender von Kalender, auch bei Google- oder Exchange-Accounts aus Systemeinstellungen › Internetaccounts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se añade al calendario predeterminado de Calendario, incluidas las cuentas de Google o Exchange añadidas en Ajustes del Sistema › Cuentas de internet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajouté au calendrier par défaut de Calendrier, y compris les comptes Google ou Exchange ajoutés dans Réglages Système › Comptes Internet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נשמר בלוח השנה המוגדר כברירת מחדל ביישום לוח שנה, כולל חשבונות Google או Exchange שנוספו בהגדרות המערכת › חשבונות אינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैलेंडर के डिफ़ॉल्ट कैलेंडर में जाता है, जिसमें सिस्टम सेटिंग्ज़ › इंटरनेट अकाउंट में जोड़े गए Google या Exchange अकाउंट भी शामिल हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk ke kalender default di Kalender, termasuk akun Google atau Exchange yang ditambahkan di Pengaturan Sistem › Akun Internet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va nel calendario predefinito di Calendario, inclusi gli account Google o Exchange aggiunti in Impostazioni di Sistema › Account Internet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーのデフォルトカレンダーに追加されます。「システム設定」›「インターネットアカウント」で追加したGoogleやExchangeのアカウントも対象です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 인터넷 계정에서 추가한 Google 또는 Exchange 계정을 포함하여 캘린더 앱의 기본 캘린더에 추가됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įvykis įrašomas į numatytąjį Kalendoriaus kalendorių, taip pat ir Google ar Exchange paskyrų, pridėtų skiltyje Sistemos nustatymai › Interneto paskyros."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaat naar de standaardagenda in Agenda, inclusief Google- of Exchange-accounts die zijn toegevoegd in Systeeminstellingen › Internetaccounts."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafia do domyślnego kalendarza w Kalendarzu, także kont Google lub Exchange dodanych w Ustawieniach systemowych › Konta internetowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai para o calendário padrão do Calendário, incluindo contas do Google ou Exchange adicionadas em Ajustes do Sistema › Contas de Internet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляется в календарь по умолчанию в Календаре, включая учетные записи Google и Exchange, добавленные в разделе «Системные настройки» › «Учетные записи интернета»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läggs i standardkalendern i Kalender, inklusive Google- eller Exchange-konton som lagts till i Systeminställningar › Internetkonton."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มไปยังปฏิทินเริ่มต้นในแอปปฏิทิน รวมถึงบัญชี Google หรือ Exchange ที่เพิ่มไว้ในการตั้งค่าระบบ › บัญชีอินเทอร์เน็ต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları › İnternet Hesapları'nda eklenen Google veya Exchange hesapları dahil, Takvim'deki varsayılan takvime eklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додається до типового календаря в Календарі, зокрема облікових записів Google чи Exchange, доданих у меню «Системні параметри» › «Облікові записи інтернету»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm vào lịch mặc định trong ứng dụng Lịch, kể cả tài khoản Google hoặc Exchange đã thêm trong Cài đặt hệ thống › Tài khoản internet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加到“日历”中的默认日历，包括在“系统设置” › “互联网账户”中添加的 Google 或 Exchange 账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入「行事曆」中的預設行事曆，包括在「系統設定」›「網際網路帳號」中加入的 Google 或 Exchange 帳號。"
          }
        }
      }
    },
