    "Audio is captured only while a call is streaming. No call, no recording." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُلتقط الصوت فقط أثناء جريان المكالمة. لا مكالمة، لا تسجيل."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvuk se zaznamenává jen během probíhajícího hovoru. Žádný hovor, žádné nahrávání."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyd optages kun, mens et opkald er i gang. Intet opkald, ingen optagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio wird nur während eines laufenden Anrufs aufgenommen. Kein Anruf, keine Aufnahme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El audio solo se capta durante una llamada en curso. Sin llamada, no hay grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’audio n’est capté que pendant un appel en cours. Pas d’appel, pas d’enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השמע נקלט רק בזמן שיש שיחה פעילה. אין שיחה, אין הקלטה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑडियो केवल तभी कैप्चर होता है जब कॉल चल रही हो। कॉल नहीं, तो रिकॉर्डिंग नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio hanya direkam saat panggilan berlangsung. Tidak ada panggilan, tidak ada rekaman."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio viene registrato solo durante una chiamata. Nessuna chiamata, nessuna registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声を取り込むのは通話中だけです。通話がなければ録音しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화가 진행되는 동안에만 오디오를 캡처합니다. 통화가 없으면 녹음도 없습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garsas įrašomas tik vykstant skambučiui. Nėra skambučio – nėra įrašo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio wordt alleen opgenomen tijdens een gesprek. Geen gesprek, geen opname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dźwięk jest nagrywany tylko podczas rozmowy. Nie ma rozmowy, nie ma nagrania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O áudio só é capturado durante uma chamada. Sem chamada, sem gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук записывается, только пока идет звонок. Нет звонка — нет записи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ljud spelas bara in medan ett samtal pågår. Inget samtal, ingen inspelning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จะบันทึกเสียงเฉพาะระหว่างที่มีการโทรเท่านั้น ไม่มีการโทร ก็ไม่มีการบันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses yalnızca bir görüşme sürerken yakalanır. Görüşme yoksa kayıt da yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Звук записується лише під час дзвінка. Немає дзвінка — немає запису."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Âm thanh chỉ được thu khi đang có cuộc gọi. Không có cuộc gọi thì không ghi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在通话进行时采集音频。没有通话，就不会录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅在通話進行時擷取音訊。沒有通話，就不會錄音。"
          }
        }
      }
    },
    "Audio only. Turn on transcripts in Settings › Transcription & AI." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صوت فقط. شغّل التفريغ في الإعدادات › التفريغ والذكاء الاصطناعي."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouze zvuk. Přepisy zapnete v Nastavení › Přepis a AI."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
