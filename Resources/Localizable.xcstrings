    "Credited after your friend's first transcription of a minute or more." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُضاف بعد أول تفريغ لصديقك مدته دقيقة أو أكثر."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připíše se po prvním přepisu vašeho přítele v délce aspoň minuty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krediteres efter din vens første transskription på et minut eller mere."
          }
        },
        "de" : {
          "stringUnit" : {
