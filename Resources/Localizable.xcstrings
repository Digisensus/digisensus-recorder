    "Couldn't compress this recording. It's kept and will be saved when Digisensus Recorder next starts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر ضغط هذا التسجيل. سيُحتفظ به ويُحفظ عند بدء تشغيل Digisensus Recorder في المرة القادمة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahrávku nelze zkomprimovat. Zůstane zachována a uloží se při příštím spuštění aplikace Digisensus Recorder."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke komprimere denne optagelse. Den bevares og gemmes, næste gang Digisensus Recorder starter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufnahme konnte nicht komprimiert werden. Sie bleibt erhalten und wird beim nächsten Start von Digisensus Recorder gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido comprimir esta grabación. Se conserva y se guardará la próxima vez que se abra Digisensus Recorder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de compresser cet enregistrement. Il est conservé et sera sauvegardé au prochain lancement de Digisensus Recorder."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא ניתן היה לדחוס את ההקלטה. היא נשמרת ותישמר בפעם הבאה ש-Digisensus Recorder יופעל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस रिकॉर्डिंग को कम्प्रेस नहीं किया जा सका। यह सुरक्षित है और अगली बार Digisensus Recorder शुरू होने पर सहेज ली जाएगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mengompresi rekaman ini. Rekaman disimpan sementara dan akan disimpan saat Digisensus Recorder dibuka lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile comprimere questa registrazione. È stata conservata e verrà salvata al prossimo avvio di Digisensus Recorder."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この録音を圧縮できませんでした。録音は保持され、次回Digisensus Recorderの起動時に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 녹음을 압축할 수 없습니다. 녹음은 보관되며 다음에 Digisensus Recorder를 시작할 때 저장됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nepavyko suglaudinti šio įrašo. Jis nedingo ir bus išsaugotas kitą kartą paleidus Digisensus Recorder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan deze opname niet comprimeren. Ze blijft bewaard en wordt opgeslagen zodra Digisensus Recorder weer start."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
