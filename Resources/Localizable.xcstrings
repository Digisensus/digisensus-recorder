    "Set it once, and your calls take care of themselves." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبطه مرة واحدة، وستتولى مكالماتك أمر نفسها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí nastavit jednou a o hovory je postaráno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil det én gang, så klarer dine opkald sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal einrichten, und Ihre Anrufe erledigen sich von selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configúralo una vez y tus llamadas se gestionan solas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez une fois, et vos appels se gèrent tout seuls."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדר פעם אחת, והשיחות שלך יסתדרו מעצמן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार सेट करें, फिर आपकी कॉल अपना ध्यान खुद रखेंगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur sekali, dan panggilan Anda akan terurus sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuralo una volta e le chiamate si gestiscono da sole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度設定すれば、あとは通話ごとに自動で処理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번만 설정하면 통화는 알아서 처리됩니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nustatykite kartą – toliau skambučiai bus įrašomi savaime."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel het één keer in en je gesprekken regelen zichzelf."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skonfiguruj raz, a rozmowy zajmą się sobą same."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure uma vez e suas chamadas se resolvem sozinhas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте один раз — дальше звонки запишутся сами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in en gång, så sköter samtalen sig själva."
          }
