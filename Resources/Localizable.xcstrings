    },
    "Allow Digisensus Recorder under System Settings › Privacy & Security › Screen & System Audio Recording › System Audio Recording Only, then record again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Digisensus Recorder ضمن إعدادات النظام › الخصوصية والأمن › تسجيل الشاشة وصوت النظام › تسجيل صوت النظام فقط، ثم سجّل مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolte Digisensus Recorder v Nastavení systému › Soukromí a zabezpečení › Nahrávání obrazovky a systémového zvuku › Pouze nahrávání systémového zvuku a pak nahrávejte znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad Digisensus Recorder under Systemindstillinger › Anonymitet & sikkerhed › Skærm- og systemlydoptagelse › Kun systemlydoptagelse, og optag så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Digisensus Recorder den Zugriff unter Systemeinstellungen › Datenschutz & Sicherheit › Bildschirm- & Systemaudioaufnahme › Nur Systemaudioaufnahme und nehmen Sie dann erneut auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da permiso a Digisensus Recorder en Ajustes del Sistema › Privacidad y seguridad › Grabación de pantalla y audio del sistema › Solo grabación de audio del sistema y vuelve a grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez Digisensus Recorder dans Réglages Système › Confidentialité et sécurité › Enregistrement de l’écran et de l’audio du système › Enregistrement de l’audio du système uniquement, puis relancez l’enregistrement."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר את Digisensus Recorder בהגדרות המערכת › פרטיות ואבטחה › הקלטת מסך ושמע מערכת › הקלטת שמע מערכת בלבד, ואז הקלט שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम सेटिंग्ज़ › गोपनीयता और सुरक्षा › स्क्रीन और सिस्टम ऑडियो रिकॉर्डिंग › केवल सिस्टम ऑडियो रिकॉर्डिंग में Digisensus Recorder को अनुमति दें, फिर दोबारा रिकॉर्ड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Digisensus Recorder di Pengaturan Sistem › Privasi & Keamanan › Perekaman Layar & Audio Sistem › Hanya Perekaman Audio Sistem, lalu rekam lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti l'accesso a Digisensus Recorder in Impostazioni di Sistema › Privacy e sicurezza › Registrazione schermo e audio di sistema › Solo registrazione audio di sistema, poi registra di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム設定」›「プライバシーとセキュリティ」›「画面収録とシステムオーディオ録音」›「システムオーディオ録音のみ」でDigisensus Recorderを許可してから、もう一度録音してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 화면 및 시스템 오디오 녹음 › 시스템 오디오 녹음만 항목에서 Digisensus Recorder를 허용한 다음 다시 녹음하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suteikite leidimą Digisensus Recorder skiltyje Sistemos nustatymai › Privatumas ir saugumas › Ekrano ir sistemos garso įrašymas › Tik sistemos garso įrašymas, tada įrašykite dar kartą."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Digisensus Recorder toe in Systeeminstellingen › Privacy en beveiliging › Scherm- en systeemaudio-opname › Alleen systeemaudio-opname en neem daarna opnieuw op."
          }
        },
        "pl" : {
