    "Claude Code, Codex and other agents on this Mac connect over MCP or the command line. Nothing listens on the network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل Claude Code وCodex والوكلاء الآخرون على هذا الـ Mac عبر MCP أو سطر الأوامر. لا شيء يستمع على الشبكة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex a další agenti na tomto Macu se připojují přes MCP nebo příkazový řádek. Nic nenaslouchá v síti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex og andre agenter på denne Mac forbinder via MCP eller kommandolinjen. Intet lytter på netværket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex und andere Agenten auf diesem Mac verbinden sich über MCP oder die Befehlszeile. Nichts lauscht im Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex y otros agentes de este Mac se conectan por MCP o la línea de comandos. Nada escucha en la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex et d’autres agents sur ce Mac se connectent via MCP ou la ligne de commande. Rien n’écoute sur le réseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex וסוכנים אחרים ב-Mac הזה מתחברים דרך MCP או שורת הפקודה. שום דבר לא מאזין ברשת."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Mac पर Claude Code, Codex और दूसरे एजेंट MCP या कमांड लाइन से जुड़ते हैं। नेटवर्क पर कुछ भी नहीं सुनता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex, dan agen lain di Mac ini terhubung melalui MCP atau baris perintah. Tidak ada yang mendengarkan di jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex e altri agenti su questo Mac si collegano tramite MCP o riga di comando. Niente resta in ascolto sulla rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上のClaude Code、Codex、その他のエージェントはMCPまたはコマンドラインで接続します。ネットワーク上での待ち受けは行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 Claude Code, Codex 및 기타 에이전트가 MCP 또는 명령줄로 연결됩니다. 네트워크에서는 연결을 받지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex ir kiti šiame Mac kompiuteryje veikiantys agentai jungiasi per MCP arba komandų eilutę. Tinkle niekas neatveriama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex en andere agents op deze Mac maken verbinding via MCP of de opdrachtregel. Er luistert niets op het netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex i inni agenci na tym Macu łączą się przez MCP lub wiersz poleceń. Nic nie nasłuchuje w sieci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex e outros agentes neste Mac se conectam via MCP ou linha de comando. Nada fica escutando na rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex и другие агенты на этом Mac подключаются через MCP или командную строку. Ничего не прослушивает сеть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex och andra agenter på den här Macen ansluter via MCP eller kommandoraden. Inget lyssnar på nätverket."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex และเอเจนต์อื่นๆ บน Mac เครื่องนี้เชื่อมต่อผ่าน MCP หรือบรรทัดคำสั่ง ไม่มีการเปิดรับการเชื่อมต่อจากเครือข่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac'teki Claude Code, Codex ve diğer ajanlar MCP veya komut satırı üzerinden bağlanır. Ağda hiçbir şey dinlemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex та інші агенти на цьому Mac під’єднуються через MCP або командний рядок. Нічого не слухає мережу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code, Codex và các tác nhân khác trên máy Mac này kết nối qua MCP hoặc dòng lệnh. Không có gì lắng nghe trên mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 上的 Claude Code、Codex 和其他智能体通过 MCP 或命令行连接，不会在网络上监听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Mac 上的 Claude Code、Codex 和其他代理透過 MCP 或命令列連線，不會在網路上監聽。"
          }
        }
      }
    },
