    "Auto-record begins the moment a call starts and ends when you hang up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ التسجيل التلقائي لحظة بدء المكالمة وينتهي عندما تُنهيها."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické nahrávání začne v okamžiku, kdy začne hovor, a skončí, když zavěsíte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk optagelse starter, så snart et opkald begynder, og stopper, når du lægger på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Auto-Aufnahme beginnt, sobald ein Anruf startet, und endet, wenn Sie auflegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación automática empieza en cuanto comienza una llamada y termina al colgar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement auto démarre dès qu’un appel commence et s’arrête quand vous raccrochez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההקלטה האוטומטית מתחילה ברגע שהשיחה מתחילה ומסתיימת כשאתה מנתק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटो-रिकॉर्ड कॉल शुरू होते ही शुरू होता है और फ़ोन रखते ही खत्म होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekam otomatis dimulai begitu panggilan dimulai dan berhenti saat Anda menutup telepon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione automatica parte appena inizia una chiamata e si ferma quando riagganci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動録音は通話の開始と同時に始まり、電話を切ると終わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 녹음은 통화가 시작되는 순간 시작되고 전화를 끊으면 끝납니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatinis įrašymas pradedamas vos prasidėjus skambučiui ir baigiamas jam pasibaigus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch opnemen begint zodra een gesprek start en stopt als je ophangt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autonagrywanie zaczyna się w chwili rozpoczęcia rozmowy i kończy, gdy się rozłączysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação automática começa assim que a chamada inicia e termina quando você desliga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автозапись начинается в момент начала звонка и заканчивается, когда Вы кладете трубку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoinspelning startar när ett samtal börjar och slutar när du lägger på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกอัตโนมัติจะเริ่มทันทีที่การโทรเริ่ม และหยุดเมื่อคุณวางสาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik kayıt, görüşme başladığı anda başlar ve telefonu kapattığınızda biter."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автозапис починається, щойно стартує дзвінок, і завершується, коли ви кладете слухавку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động ghi bắt đầu ngay khi cuộc gọi bắt đầu và kết thúc khi bạn gác máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动录音在通话开始时立即启动，挂断时结束。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動錄音在通話開始時立即啟動，掛斷時結束。"
          }
        }
      }
    },
