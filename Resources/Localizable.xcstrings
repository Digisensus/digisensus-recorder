    "Digisensus Recorder is free and open source software. You can redistribute and modify it under the GNU General Public License version 3, with an attribution term. It comes with no warranty." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder برنامج مجاني ومفتوح المصدر. يمكنك إعادة توزيعه وتعديله بموجب رخصة جنو العمومية العامة (GNU GPL) الإصدار 3، مع شرط الإسناد. ويأتي دون أي ضمان."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder je svobodný software s otevřeným zdrojovým kódem. Můžete ho šířit a upravovat podle licence GNU General Public License verze 3 s podmínkou uvedení autora. Je poskytován bez jakékoli záruky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder er fri og open source-software. Du kan videredistribuere og ændre den under GNU General Public License version 3 med et krav om kildeangivelse. Den leveres uden nogen garanti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder ist freie Open-Source-Software. Sie dürfen sie gemäß der GNU General Public License Version 3 mit einer Namensnennungsklausel weitergeben und verändern. Sie wird ohne jegliche Gewährleistung bereitgestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder es software libre y de código abierto. Puedes redistribuirlo y modificarlo según la Licencia Pública General de GNU versión 3, con una cláusula de atribución. Se ofrece sin ninguna garantía."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder est un logiciel libre et open source. Vous pouvez le redistribuer et le modifier selon les termes de la licence publique générale GNU version 3, avec une clause d’attribution. Il est fourni sans aucune garantie."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder היא תוכנה חופשית בקוד פתוח. מותר להפיץ ולשנות אותה לפי הרישיון הציבורי הכללי של GNU, גרסה 3, עם תנאי ייחוס. היא מסופקת ללא כל אחריות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder मुफ़्त और ओपन सोर्स सॉफ़्टवेयर है। आप इसे GNU जनरल पब्लिक लाइसेंस संस्करण 3 के तहत, एक एट्रिब्यूशन शर्त के साथ, फिर से वितरित और संशोधित कर सकते हैं। इसके साथ कोई वारंटी नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder adalah perangkat lunak gratis dan sumber terbuka. Anda dapat mendistribusikan ulang dan memodifikasinya berdasarkan GNU General Public License versi 3, dengan ketentuan atribusi. Perangkat lunak ini disediakan tanpa jaminan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder è software libero e open source. Puoi ridistribuirlo e modificarlo secondo la GNU General Public License versione 3, con una clausola di attribuzione. Viene fornito senza alcuna garanzia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorderはフリーかつオープンソースのソフトウェアです。帰属表示の条項を付したGNU General Public License バージョン3に基づき、再配布や改変を行うことができます。本ソフトウェアは無保証です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder는 무료 오픈 소스 소프트웨어입니다. 저작자 표시 조건이 추가된 GNU General Public License 버전 3에 따라 재배포하거나 수정할 수 있습니다. 어떠한 보증도 제공되지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder yra nemokama atvirojo kodo programinė įranga. Ją galite platinti ir keisti pagal GNU bendrosios viešosios licencijos 3 versiją su autorystės nurodymo sąlyga. Jokia garantija neteikiama."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder is vrije en opensourcesoftware. Je mag het verspreiden en aanpassen onder de GNU General Public License versie 3, met een voorwaarde voor naamsvermelding. Het wordt geleverd zonder enige garantie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder to wolne oprogramowanie o otwartym kodzie źródłowym. Możesz je rozpowszechniać i modyfikować na warunkach licencji GNU General Public License w wersji 3 z klauzulą o uznaniu autorstwa. Jest dostarczane bez żadnej gwarancji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Digisensus Recorder é software livre e de código aberto. Você pode redistribuí-lo e modificá-lo sob a GNU General Public License versão 3, com um termo de atribuição. Ele é fornecido sem nenhuma garantia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder — свободное программное обеспечение с открытым исходным кодом. Вы можете распространять и изменять его на условиях GNU General Public License версии 3 с условием указания авторства. Предоставляется без каких-либо гарантий."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder är fri programvara med öppen källkod. Du får distribuera och ändra den enligt GNU General Public License version 3, med ett villkor om erkännande. Den levereras utan garanti."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder เป็นซอฟต์แวร์เสรีและโอเพนซอร์ส คุณสามารถแจกจ่ายต่อและแก้ไขได้ภายใต้ GNU General Public License เวอร์ชัน 3 พร้อมเงื่อนไขการระบุแหล่งที่มา ซอฟต์แวร์นี้ไม่มีการรับประกันใดๆ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder özgür ve açık kaynaklı bir yazılımdır. GNU Genel Kamu Lisansı sürüm 3 ve bir atıf koşulu kapsamında yeniden dağıtabilir ve değiştirebilirsiniz. Hiçbir garanti verilmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder — вільне програмне забезпечення з відкритим кодом. Ви можете поширювати та змінювати його згідно з GNU General Public License версії 3 з умовою зазначення авторства. Надається без жодних гарантій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder là phần mềm tự do và mã nguồn mở. Bạn có thể phân phối lại và sửa đổi theo Giấy phép Công cộng GNU phiên bản 3, kèm điều khoản ghi công. Phần mềm không đi kèm bất kỳ bảo đảm nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder 是自由开源软件。你可以依据附带署名条款的 GNU 通用公共许可证第 3 版重新分发和修改它。本软件不提供任何担保。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digisensus Recorder 是自由開源軟體。你可以依據附帶署名條款的 GNU 通用公共授權條款第 3 版重新散布和修改它。本軟體不提供任何擔保。"
          }
        }
      }
    },
