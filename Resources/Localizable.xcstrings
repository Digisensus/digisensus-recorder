    "Calendar has no default calendar for new events. Choose one in Calendar › Settings › General." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد في التقويم تقويم افتراضي للأحداث الجديدة. اختر واحدًا في التقويم › الإعدادات › عام."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalendář nemá výchozí kalendář pro nové události. Vyberte ho v nabídce Kalendář › Nastavení › Obecné."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalender har ingen standardkalender til nye begivenheder. Vælg en i Kalender › Indstillinger › Generelt."
