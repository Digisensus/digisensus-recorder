    "Off, the app lives in the menu bar and appears in the Dock only while a window is open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند الإيقاف، يبقى التطبيق في شريط القائمة ولا يظهر في Dock إلا عندما تكون إحدى نوافذه مفتوحة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je vypnuto, aplikace je v řádku nabídek a v Docku se zobrazí jen při otevřeném okně."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når den er slået fra, bor appen i menulinjen og vises kun i Dock, mens et vindue er åbent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aus, befindet sich die App in der Menüleiste und erscheint nur im Dock, solange ein Fenster geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, la app vive en la barra de menús y solo aparece en el Dock mientras haya una ventana abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si désactivé, l’app reste dans la barre des menus et n’apparaît dans le Dock que lorsqu’une fenêtre est ouverte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כשהאפשרות כבויה, האפליקציה נמצאת בשורת התפריטים ומופיעה ב-Dock רק כשחלון פתוח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बंद होने पर ऐप मेनू बार में रहता है और Dock में केवल तभी दिखता है जब कोई विंडो खुली हो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika nonaktif, app berada di bar menu dan hanya muncul di Dock saat ada jendela yang terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se disattivato, l'app vive nella barra dei menu e appare nel Dock solo quando c'è una finestra aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフの場合、Appはメニューバーに常駐し、ウインドウが開いているときだけDockに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끄면 앱이 메뉴 막대에 있고, 윈도우가 열려 있을 때만 Dock에 나타납니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai išjungta, programa veikia meniu juostoje, o Dock juostoje rodoma tik tada, kai atidarytas langas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien uit, staat de app in de menubalk en verschijnt hij alleen in het Dock als er een venster open is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy wyłączone, aplikacja jest na pasku menu i pojawia się w Docku tylko przy otwartym oknie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desativado, o app fica na barra de menus e só aparece no Dock enquanto houver uma janela aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если выключено, приложение находится в строке меню и появляется в Dock, только когда открыто окно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Av: appen finns i menyraden och visas bara i Dock medan ett fönster är öppet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อปิด แอปจะอยู่ในแถบเมนูและแสดงใน Dock เฉพาะเมื่อมีหน้าต่างเปิดอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapalıyken uygulama menü çubuğunda yaşar ve Dock'ta yalnızca bir pencere açıkken görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо вимкнено, програма живе на смузі меню й з’являється в Dock, лише коли відкрито вікно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi tắt, ứng dụng nằm trên thanh menu và chỉ hiện trong Dock khi có cửa sổ đang mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭时，App 位于菜单栏中，仅在窗口打开时显示在程序坞中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉時，App 位於選單列中，僅在視窗打開時顯示在 Dock 中。"
          }
        }
      }
    },
