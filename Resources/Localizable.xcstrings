    "Get a transcript showing who said what, a short summary and tags." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احصل على تفريغ يُظهر من قال ماذا، وملخص قصير ووسوم."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Získejte přepis, ve kterém je vidět, kdo co řekl, krátké shrnutí a štítky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en udskrift, der viser, hvem der sagde hvad, et kort resumé og mærker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalten Sie ein Transkript, das zeigt, wer was gesagt hat, eine kurze Zusammenfassung und Tags."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtén una transcripción que muestra quién dijo qué, un breve resumen y etiquetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenez une transcription indiquant qui a dit quoi, un court résumé et des tags."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קבל תמליל שמראה מי אמר מה, סיכום קצר ותגים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसा ट्रांसक्रिप्ट पाएँ जो बताए कि किसने क्या कहा, साथ में एक छोटा सारांश और टैग।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan transkrip yang menunjukkan siapa mengatakan apa, ringkasan singkat, dan tag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottieni una trascrizione con chi ha detto cosa, un breve riepilogo e i tag."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰が何を話したかがわかる文字起こし、短い要約、タグを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누가 무엇을 말했는지 보여 주는 녹취록, 짧은 요약 및 태그를 받으세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaukite stenogramą, kurioje matyti, kas ką pasakė, trumpą santrauką ir žymas."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krijg een transcript dat laat zien wie wat zei, een korte samenvatting en tags."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymaj transkrypcję pokazującą, kto co powiedział, krótkie podsumowanie i tagi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenha uma transcrição que mostra quem disse o quê, um resumo curto e etiquetas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получите расшифровку с указанием, кто что сказал, краткую сводку и теги."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en transkription som visar vem som sa vad, en kort sammanfattning och taggar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รับข้อความถอดเสียงที่แสดงว่าใครพูดอะไร พร้อมสรุปสั้นๆ และแท็ก"
